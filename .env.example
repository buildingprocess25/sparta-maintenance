# ==============================================================================
# KONFIGURASI DATABASE
# ==============================================================================
# String koneksi ke database PostgreSQL kamu.
# Untuk development lokal, kamu bisa menggunakan Docker atau instalasi Postgres lokal.
# Contoh: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=disable
DATABASE_URL=""

# URL Langsung (Direct URL) yang digunakan untuk migrasi Prisma (biasanya sama dengan DATABASE_URL kecuali jika menggunakan connection pooler seperti PgBouncer)
DIRECT_URL=""

DATABASE_POOL_MAX="5"
DATABASE_IDLE_TIMEOUT_MS="10000"
DATABASE_CONNECTION_TIMEOUT_MS="10000"

# ==============================================================================
# KONFIGURASI APLIKASI
# ==============================================================================
# Secret key yang digunakan untuk enkripsi sesi.
# Cara mendapatkan: Jalankan `openssl rand -base64 32` di terminal atau gunakan `npx auth secret`.
SESSION_SECRET=""
TZ=UTC

# ==============================================================================
# KONFIGURASI GOOGLE OAUTH
# ==============================================================================
# Cara mendapatkan:
# 1. Buka Google Cloud Console (console.cloud.google.com).
# 2. Buat Project -> APIs & Services -> Credentials.
# 3. Buat OAuth 2.0 Client ID (Web Application).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Cara mendapatkan Refresh Token:
# Kamu perlu melakukan autentikasi via Google OAuth 2.0 Playground (developers.google.com/oauthplayground).
# Pastikan untuk mengizinkan (authorize) scope yang dibutuhkan (misal: Drive API, Gmail API) lalu tukarkan (exchange) auth code dengan refresh token.
GOOGLE_REFRESH_TOKEN=""

# Akun Gmail yang digunakan sebagai pengirim email sistem.
GMAIL_USER=""

# ==============================================================================
# KONFIGURASI GOOGLE DRIVE
# ==============================================================================
# ID dari root folder di Google Drive tempat file aplikasi akan disimpan.
# Cara mendapatkan: Buka folder di Google Drive. ID adalah string panjang yang ada di akhir URL.
# Contoh: https://drive.google.com/drive/folders/[ID_NYA_DISINI]
GOOGLE_DRIVE_ROOT_FOLDER_ID=""

# Folder ID untuk backup aplikasi di Google Drive.
BACKUP_DRIVE_FOLDER_ID=""

# ==============================================================================
# URL APLIKASI NEXT
# ==============================================================================
# produksi (prod)
# NEXT_PUBLIC_APP_URL=https://url-produksi-kamu.com
# APP_BASE_URL=https://url-produksi-kamu.com

# pengembangan (dev)
NEXT_PUBLIC_APP_URL=http://localhost:3001
APP_BASE_URL=http://localhost:3001

# ==============================================================================
# LAIN-LAIN & MAINTENANCE
# ==============================================================================
# String rahasia untuk memproteksi endpoint cron. Generate string acak apa saja.
CRON_SECRET=""
CLEANUP_PENDING_EXPIRY_DAYS="14"

MAINTENANCE_MODE="false"
REQUEST_LOG_ENABLED="true"
REQUEST_LOG_SAMPLE_RATE="0.15"
REQUEST_LOG_SLOW_MS="1200"

# ==============================================================================
# KONFIGURASI DRIVE CDN
# ==============================================================================
# Kredensial Google yang terpisah jika kamu menggunakan service account/klien berbeda untuk CDN.
# Ikuti langkah yang sama dengan KONFIGURASI GOOGLE OAUTH di atas.
DRIVE_CDN_CLIENT_ID=""
DRIVE_CDN_CLIENT_SECRET=""
DRIVE_CDN_REFRESH_TOKEN=""

# ID root folder untuk aset CDN (lihat KONFIGURASI GOOGLE DRIVE untuk cara mendapatkan ID-nya).
DRIVE_CDN_ROOT_FOLDER_ID=""

# ==============================================================================
# WEB PUSH NOTIFICATIONS (VAPID)
# ==============================================================================
# Cara mendapatkan:
# Jalankan `npx web-push generate-vapid-keys` di terminal untuk membuat sepasang kunci (keys).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# URL atau alamat 'mailto:'. Digunakan oleh layanan push untuk menghubungi kamu jika ada masalah.
VAPID_SUBJECT="mailto:email_kamu@example.com"

NEXT_PUBLIC_NOTIFICATIONS_ENABLED=true
NEXT_PUBLIC_WEB_PUSH_ENABLED=true
NEXT_PUBLIC_NOTIFICATION_GATE_REQUIRED=true

# ==============================================================================
# INTEGRASI GOOGLE SHEETS
# ==============================================================================
# Cara mendapatkan: Buka Google Sheet kamu, ID berada di URL antara /d/ dan /edit.
# Contoh: https://docs.google.com/spreadsheets/d/[ID_NYA_DISINI]/edit
GOOGLE_STORE_SPREADSHEET_ID=""
# Range (rentang) yang ingin kamu baca/tulis.
GOOGLE_STORE_SHEET_RANGE='Sheet 1'!A:E

# ==============================================================================
# SSO Integration — SPARTA Login Portal
# ==============================================================================
# Development: arahkan ke local SPARTA API (PORT=10000 di login-sparta/apps/api/.env.development)
# Production:  ganti ke https://login.sparta.local (atau domain production yang sebenarnya)
SPARTA_API_URL=http://localhost:10000
